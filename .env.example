# FreshChain AI — Environment Configuration Template
# Copy this file to .env and insert your Azure Student Subscription credentials.
# NEVER commit your actual .env file to version control.

# 1. Azure Blob Storage Configuration (Phase 4)
# Azure Storage Account -> Access Keys -> Connection String
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=freshchainstorage
CONTAINER_RAW=freshchain-raw
CONTAINER_PROCESSED=freshchain-processed
CONTAINER_ANALYTICS=freshchain-analytics

# 2. Azure ML Workspace & MLflow Tracking (Phase 5)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=freshchain-rg
AZURE_ML_WORKSPACE_NAME=freshchain-mlw
MLFLOW_TRACKING_URI=

# 3. Model & Serverless Configuration (Phase 6)
PREDICTION_API_PORT=8000
ENVIRONMENT=development
